@* One side's clock. Counts down between server pushes and re-syncs on every new snapshot. *@
@implements IDisposable
@inject TimeProvider Time
@inject IJSRuntime JS

@if (WarnWithSound)
{
    <div class="clock-wrap">
        <button type="button" class="sound-toggle" @onclick="ToggleSoundAsync"
                aria-pressed="@(_soundOn ? "true" : "false")"
                title="@(_soundOn ? "Low-time sound on (click to mute)" : "Low-time sound muted (click to unmute)")"
                aria-label="@(_soundOn ? "Mute low-time sound" : "Unmute low-time sound")">
            @(_soundOn ? "🔊" : "🔇")
        </button>
        @ClockFace
    </div>
}
else
{
    @ClockFace
}

@code {
    private static readonly TimeSpan Tick = TimeSpan.FromMilliseconds(100);
    private ITimer? _timer;
    private string _shown = string.Empty;
    private bool _low;
    private bool _lowKnown;
    private bool _soundOn = true;

    [Parameter, EditorRequired]
    public ClockSnapshot Snapshot { get; set; } = default!;

    [Parameter, EditorRequired]
    public TimeControl TimeControl { get; set; } = default!;

    [Parameter]
    public ClockSide Side { get; set; }

    /// <summary>Play the low-time sound for this clock. Set only on the viewer's own clock.</summary>
    [Parameter]
    public bool WarnWithSound { get; set; }

    private bool IsRunning => Snapshot.Running == Side;

    private RenderFragment ClockFace => @<div class="clock @(IsRunning ? "running" : null) @(_low ? "low" : null) @(_shown == "0:00.0" ? "flagged" : null)"
                                             role="timer" aria-label="@($"{Side} clock {_shown}")">
        @_shown
    </div>;

    protected override void OnParametersSet()
    {
        var remaining = Remaining();
        _shown = Format(remaining);
        UpdateLow(remaining);
        _timer?.Dispose();
        _timer = IsRunning ? Time.CreateTimer(_ => OnTick(), null, Tick, Tick) : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && WarnWithSound)
        {
            try
            {
                _soundOn = await JS.InvokeAsync<bool>("genesisChess.sound.isEnabled");
                StateHasChanged();
            }
            catch (JSException)
            {
            }
        }
    }

    private TimeSpan Remaining()
    {
        var remaining = Snapshot.RemainingFor(Side);
        if (IsRunning)
        {
            remaining -= Time.GetUtcNow() - Snapshot.TakenAt;
        }

        return remaining < TimeSpan.Zero ? TimeSpan.Zero : remaining;
    }

    /// <summary>
    /// Tracks the low-time state and plays the warning once per crossing into it. The first
    /// reading only records the state, so reopening a game already in low time stays silent.
    /// An increment that lifts the clock back above the threshold re-arms the warning.
    /// </summary>
    /// <returns>True when the low-time state changed.</returns>
    private bool UpdateLow(TimeSpan remaining)
    {
        var low = TimeControl.IsLowTime(remaining);
        var crossed = _lowKnown && low && !_low;
        var changed = low != _low;
        _low = low;
        _lowKnown = true;

        if (crossed && IsRunning && WarnWithSound && _soundOn && remaining > TimeSpan.Zero)
        {
            _ = InvokeAsync(PlayWarningAsync);
        }

        return changed;
    }

    private async Task PlayWarningAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("genesisChess.sound.lowTime");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleSoundAsync()
    {
        _soundOn = !_soundOn;
        try
        {
            await JS.InvokeVoidAsync("genesisChess.sound.setEnabled", _soundOn);
        }
        catch (JSException)
        {
        }
    }

    private void OnTick()
    {
        var remaining = Remaining();
        var text = Format(remaining);
        _ = InvokeAsync(() =>
        {
            var lowChanged = UpdateLow(remaining);
            if (text == _shown && !lowChanged)
            {
                return; // Only push a render when the visible digits or the low state change.
            }

            _shown = text;
            StateHasChanged();
        });
    }

    internal static string Format(TimeSpan t)
    {
        var culture = System.Globalization.CultureInfo.InvariantCulture;
        if (t < TimeSpan.FromSeconds(10))
        {
            // Truncate, never round up, so the display never shows time the player doesn't have.
            var tenths = (int)(t.Ticks / TimeSpan.TicksPerMillisecond / 100);
            return string.Create(culture, $"0:0{tenths / 10}.{tenths % 10}");
        }

        return t.TotalHours >= 1
            ? string.Create(culture, $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}")
            : string.Create(culture, $"{(int)t.TotalMinutes}:{t.Seconds:00}");
    }

    public void Dispose() => _timer?.Dispose();
}
