@* Moves in numbered White/Black pairs, newest scrolled into view. Clicking a move shows the position after it. *@
@inject IJSRuntime JS

<div class="moves" aria-label="Move list" @ref="_root">
    @if (Moves.Count == 0)
    {
        <p class="muted none">No moves yet.</p>
    }
    else
    {
        <ol>
            @for (var i = 0; i < Moves.Count; i += 2)
            {
                <li>
                    <span class="num">@((i / 2) + 1).</span>
                    @PlyButton(i)
                    @if (i + 1 < Moves.Count)
                    {
                        @PlyButton(i + 1)
                    }
                </li>
            }
        </ol>
    }
</div>

@code {
    private ElementReference _root;
    private int? _revealedPly;

    [Parameter, EditorRequired]
    public IReadOnlyList<MoveRecord> Moves { get; set; } = [];

    /// <summary>Ply whose position is on the board (1-based), or null when showing the live position.</summary>
    [Parameter]
    public int? ViewedPly { get; set; }

    /// <summary>Raised with the ply (1-based) of the clicked move.</summary>
    [Parameter]
    public EventCallback<int> OnSelect { get; set; }

    private int CurrentPly => ViewedPly ?? Moves.Count;

    private RenderFragment PlyButton(int index) => __builder =>
    {
        var move = Moves[index];
        var ply = index + 1;
        var classes = string.Join(' ', new[]
        {
            "ply",
            ply == Moves.Count ? "latest" : null,
            ply == CurrentPly ? "current" : null,
            move.Action is PlaceAction ? "drop" : null,
        }.Where(c => c is not null));
        <button type="button" class="@classes" aria-current="@(ply == CurrentPly ? "step" : null)"
                aria-label="@($"Go to move {(index / 2) + 1}{(move.By == Color.White ? "" : "...")} {move.San}")"
                @onclick="() => OnSelect.InvokeAsync(ply)">@move.San</button>
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only scroll for review; when live the column-reverse layout already keeps the newest move in view.
        if (ViewedPly == _revealedPly)
        {
            return;
        }

        _revealedPly = ViewedPly;
        if (ViewedPly is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("genesisChess.revealCurrent", _root);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or OperationCanceledException)
            {
                // Scrolling is cosmetic.
            }
        }
    }
}
